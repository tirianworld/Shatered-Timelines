# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_REPO: Official data & assets repository
GITHUB_REPO="theworldoftirian/Cdd-Gacha-Datos"
GITHUB_BRANCH="main"

# GITHUB_TOKEN: token con permiso de escritura sobre el repositorio de datos.
# No se escribe en el código. En local, copia este archivo a .env (ignorado por git)
# y pega ahí el valor. En la nube, guárdalo en Settings → Secrets del proyecto.
GITHUB_TOKEN=""

# Google Play Games Services (API oficial, acceso desde el servidor).
PLAY_GAMES_CLIENT_ID=""
PLAY_GAMES_CLIENT_SECRET=""

# ALLOWED_ORIGINS: dominios autorizados a llamar a la API desde otro origen,
# separados por comas. Necesario para el paquete de Play Store si no carga el
# mismo dominio del servidor. Ejemplo:
# ALLOWED_ORIGINS="https://app.tudominio.com,https://localhost"
ALLOWED_ORIGINS=""

# TWA_PACKAGE_NAME y TWA_SHA256_FINGERPRINTS: verificación de la app Android (TWA).
# El servidor publica /.well-known/assetlinks.json con estos datos.
# Las huellas SHA-256 van separadas por comas (Play App Signing y clave de subida).
# TWA_PACKAGE_NAME="com.tudominio.cddgacha"
# TWA_SHA256_FINGERPRINTS="AA:BB:...,CC:DD:..."
TWA_PACKAGE_NAME=""
TWA_SHA256_FINGERPRINTS=""

# VITE_API_BASE_URL: solo para el BUILD del cliente. Si el paquete (WebView/Capacitor)
# no se sirve desde el mismo dominio que la API, apunta aquí al servidor público.
# En la web normal se deja vacío.
VITE_API_BASE_URL=""
